# Clés API TontumaBot
GROQ_API_KEY=
GEMINI_API_KEY=

# Fournisseur LLM par défaut : groq | gemini
LLM_PROVIDER=groq

# Modèle de traduction NLLB
NLLB_MODEL=bilalfaye/nllb-200-distilled-600M-wo-fr-en

# Modèle STT wolof (chemin local du LoRA whisper)
STT_MODEL_PATH=./wolof-whisper-small-lora

# Langue STT (laisser vide = auto). Ex: wo
STT_LANGUAGE=

# Langues OCR tesseract (combinaison '+')
OCR_LANGS=fra+eng

# Hôte / port du serveur
HOST=0.0.0.0
PORT=8000
# Modèle d'embedding (multilingue FR/WO)
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Modèle TTS wolof (SpeechT5 fine-tuné) — vide = voix FR edge-tts
WOLOF_TTS_MODEL=bilalfaye/speecht5_tts-wolof-v0.2
