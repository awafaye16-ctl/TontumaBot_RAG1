# ─────────────────────────────────────────────────────
#  TontumaBot V3 — Configuration (exemple)
#  Copiez ce fichier en .env et remplissez vos clés
# ─────────────────────────────────────────────────────

# ── Préchargement des modèles au démarrage (recommandé en usage persistant) ──
# PRELOAD_MODELS=true

# ── Session / mémoire courte ────────────────────────────
# 5 questions max par session, expiration après 120 s (2 min) d'inactivité.
MAX_QUESTIONS_PER_SESSION=5
SESSION_INACTIVITY_SECONDS=120
MEMORY_MAX_TURNS=5

# ── LLM ──────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=4096
GEMINI_API_KEY=
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LOCAL_LLM_QUANT=4bit

# ── Traduction ────────────────────────────────────────
NLLB_WO_FR_MODEL=./src/Wo_fr_bilalfayenllb-200-distilled-600M-wo-fr-en
NLLB_FR_WO_MODEL=./src/Fr-Wo_Lahadnllb200-francais-wolof

# ── STT ───────────────────────────────────────────────
# Résolution automatique par config.py (voir download_models.py) :
#   WO → wolof-whisper-small-lora/ ou src/models/stt_wolof_whisper_small/ (M9and2M/whisper-small-wolof)
#   FR → src/models/stt_french_whisper_medium/ (pierreguillou/whisper-medium-french)
# STT_WO_MODEL_DIR=./wolof-whisper-small-lora
# STT_FR_MODEL_DIR=./src/models/stt_french_whisper_medium
STT_LANGUAGE=

# ── Dataset Hugging Face (optionnel) ──────────────────
# HF_DOCUMENTS_DATASET=ton-equipe/tontumabot-documents
HF_DATASET_SPLIT=train
HF_TEXT_COLUMN=text
HF_TITLE_COLUMN=title
HF_SOURCE_COLUMN=source

# ── Embeddings ────────────────────────────────────────
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── TTS ───────────────────────────────────────────────
TTS_ENGINE=oolel
OOLEL_TTS_REPO=soynade-research/Oolel-Voices
# Voix clonée de référence (voice cloning) pour Oolel-Voices
OOLEL_VOICE_PROMPT=./Oolel-Voices/Voca.mp3
WOLOF_TTS_MODEL=bilalfaye/speecht5_tts-wolof-v0.2

# ── Reranker ──────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=3

# ── Serveur ───────────────────────────────────────────
HOST=0.0.0.0
PORT=8008
OCR_LANGS=fra+eng
